# Test environment. Tiny limits make rate limiting observable in functional tests.
APP_ENV=test
APP_DEBUG=0
APP_SECRET=test-app-secret-0123456789abcdef

DATABASE_URL="postgresql://app:app@database:5432/seller_api_test?serverVersion=16&charset=utf8"
REDIS_URL="redis://redis:6379?timeout=1&read_timeout=1"

JWT_SECRET=test-jwt-secret-0123456789abcdef0123456789abcdef
JWT_TTL=900
API_KEY_PEPPER=test-api-key-pepper-0123456789abcdef

RATE_LIMIT_IP=50
RATE_LIMIT_MERCHANT=20
RATE_LIMIT_AUTH_FAILURES=3

TRUSTED_PROXIES=127.0.0.1
